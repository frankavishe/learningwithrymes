# Copy to .env for local dev. Values below match docker-compose.yml at the repo root.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=rhythm_app_user
DB_PASSWORD=app_secure_password
DB_DATABASE=rhythm_notes

JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=1h

PORT=3000

# Redis — backs the BullMQ queue that runs the Phase 4 AI generation pipeline as an async job (AI-005)
REDIS_HOST=localhost
REDIS_PORT=6379

# Stage 1 (lyric structuring) — Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stage 2 (audio generation) — Replicate-hosted Meta MusicGen (instrumental only, no vocal synthesis;
# see specs/04-ai-generation-pipeline.md Open Questions for why the app treats this as a karaoke backing track)
REPLICATE_API_TOKEN=
REPLICATE_MUSICGEN_MODEL=meta/musicgen

# Object storage (Phase 6) — MinIO in dev, self-hosted via docker-compose.yml (S3-compatible; the
# same StorageService works against AWS S3 in prod by pointing these at S3's endpoint/credentials
# instead — see specs/06-audio-storage.md Open Questions).
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=rhythm_minio_admin
MINIO_SECRET_KEY=rhythm_minio_password
MINIO_BUCKET=rhythmnotes-audio
MINIO_PUBLIC_URL=http://localhost:9000
